@@ -0,0 +1,134 @@
+% ca-tagging.tex
+%
+% Adjustments used only when producing a tagged (accessible) PDF, that is,
+% when ca.tex is run through lualatex (\DocumentMetadata with tagging=on).
+% It is read by ca.tex via \IfDocumentMetadataTF, so pdflatex never sees it.
+%
+% Two kinds of things are here:
+%  1. Tagging for things LaTeX does not tag by itself (titlesec headings).
+%  2. Workarounds so that the tagged output looks the same as the pdflatex
+%     output (LaTeX's tagging code changes some spacing by itself).
+%
+% Tested with TeX Live 2026 (LaTeX 2026-06-01).  Much of this pokes at
+% LaTeX's tagging internals, so it may need revisiting when they change.
+
+\makeatletter
+\ExplSyntaxOn
+
+%%% Headings (titlesec)
+%
+% LaTeX's tagging code only tags its own heading commands, which we
+% disable in ca.tex to keep the titlesec formatting.  So wrap titlesec's
+% \ttl@select to open/close the Sect structures and to tag the title
+% paragraph as H1, H2, ... (chapter = level 0, section = 1, ...).
+\tl_new:N \l__ca_level_tl
+\cs_new_eq:NN \__ca_ttl_select:nnnn \ttl@select
+\cs_gset_protected:Npn \ttl@select #1#2#3#4
+  {
+    \tl_set:Ne \l__ca_level_tl { \int_eval:n { \use:c { ttll@#1 } } }
+    \UseTaggingSocket{sec/end}{\l__ca_level_tl}
+    \UseTaggingSocket{sec/begin}
+      {{\l__ca_level_tl}{tag=\UseStructureName{sec/\l__ca_level_tl}}}
+    \group_begin:
+      \UseTaggingSocket{sec/title/init}{\l__ca_level_tl}
+      \__ca_ttl_select:nnnn {#1}{#2}{#3}{#4}
+    \group_end:
+  }
+
+% Decorations in headings (\cadeco inline, \cadecopar a whole paragraph)
+% become artifacts, so screen readers skip them.
+\cs_gset_protected:Npn \cadeco #1
+  {
+    \tag_mc_end_push:
+    \tag_mc_begin:n {artifact}
+    \tag_suspend:n {cadeco}
+    #1
+    \tag_resume:n {cadeco}
+    \tag_mc_end:
+    \tag_mc_begin_pop:n {}
+  }
+\cs_gset_protected:Npn \cadecopar #1
+  {
+    \tagpdfparaOff
+    \tag_mc_begin:n {artifact}
+    \tag_suspend:n {cadecopar}
+    #1 \par
+    \tag_resume:n {cadecopar}
+    \tag_mc_end:
+    \tagpdfparaOn
+  }
+
+%%% Display followed by a blank line
+%
+% When a display is followed by a blank line, the tagging code re-adds
+% \parskip as the last glue, so a following list/theorem/exbox cannot merge
+% its space with the space below the display (\addvspace), giving extra
+% space.  Re-add \parskip underneath the last skip instead.
+\def\@doendpe{\@endpetrue
+  \def\par
+    {
+      \@restorepar
+      \clubpenalty\@clubpenalty
+      \if@domathendpe
+        \skip_set_eq:NN \l_tmpa_skip \lastskip
+        \skip_vertical:n { -\l_tmpa_skip }
+        \skip_vertical:n { \tex_parskip:D }
+        \skip_vertical:n { \l_tmpa_skip }
+        \@domathendpefalse
+      \fi
+      \tag_socket_use:n {@doendpe}
+      \@endpefalse
+      \everypar{}
+      \par
+    }
+  \everypar{{\setbox\z@\lastbox}
+            \everypar{}
+            \@endpefalse
+            \@domathendpefalse
+  }
+}
+
+%%% Theorem spacing
+%
+% With tagging, amsthm is replaced by an emulation whose spacing differs:
+% * it adds \partopsep before theorems defined with \newtheoremstyle
+%   (newpxtext's theoremfont option redefines "plain" that way),
+% * styles it does not know (definition) fall back to "plain", but amsthm
+%   uses \topsep (as of the preamble) for them.
+\DeclareInstanceCopy{block}{thm-definition-1}{thm-legacy2e-1}
+\EditInstance{block}{thm-definition-1}
+  { begin-vspace:e = \the\topsep, end-vspace:e = \the\topsep }
+\DeclareInstanceCopy{block}{thm-definition-2}{thm-definition-1}
+\AddToHook{begindocument}
+  {
+    \clist_map_inline:nn {plain,definition,exercise,example}
+      {
+        \EditInstance{block}{thm-#1-1}{begin-extra-vspace=0pt}
+        \EditInstance{block}{thm-#1-2}{begin-extra-vspace=0pt}
+      }
+  }
+
+%%% Captions
+%
+% The tagging code replaces \@makecaption at \begin{document}, losing the
+% caption package layout.  Use the caption package's typesetting inside
+% the tagging sockets.
+\AddToHook{begindocument}
+  {
+    \long\def\@makecaption#1#2
+      {
+        \UseHookWithArguments{cmd/@makecaption/before}{2}{#1}{#2}
+        \UseTaggingSocket{caption/begin}{\@current@float@struct}
+        \caption@makecaption{#1}{#2}
+        \UseTaggingSocket{caption/end}
+      }
+  }
+
+%%% Footnotes
+%
+% The tagging output routine puts footnotes right below the text on short
+% pages; keep the classic placement at the bottom of the page.
+\AssignSocketPlug{build/column/outputbox}{footnotes-floats-legacy}
+
+\ExplSyntaxOff
+\makeatother
